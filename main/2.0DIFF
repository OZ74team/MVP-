+/* ===== 섹션 4. MVP 등록 | 담당: 노화성 =====
    현재 브라우저의 localStorage에 저장합니다.
    모든 사용자에게 공유하려면 서버/API와 데이터베이스 연동이 필요합니다. */
 const mvpForm = document.querySelector('#mvpForm');