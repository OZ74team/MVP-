-/* ===== 섹션 4. 마지막 안내 | 담당: 곽재영 ===== */
+/* ===== 섹션 4. MVP 등록 | 담당: 노화성 ===== */
+.submit { background-color: var(--color-dawn); border-top: 2px solid var(--color-twig); }
+.submit-heading { max-width: 680px; margin-bottom: 36px; }
+.submit-eyebrow { margin-bottom: 10px; color: var(--color-bark); font-size: 12px; font-weight: 700; letter-spacing: .14em; }
+.submit-heading .section-title { margin-bottom: 12px; }
+.submit-desc { color: var(--color-bark); }
+.submit-layout { display: grid; grid-template-columns: 1.35fr .85fr; gap: 28px; align-items: stretch; }
+.submit-form, .submit-preview { padding: 32px; background: var(--color-white); border: 2px solid var(--color-twig); border-radius: 24px; }
+.submit-field { margin-bottom: 20px; }
+.submit-field label { display: block; margin-bottom: 8px; font-weight: 700; }
+.submit-field label span { color: var(--color-yolk-deep); }
+.submit-field input, .submit-field textarea, .submit-field select { display: block; width: 100%; padding: 13px 14px; border: 2px solid var(--color-line); border-radius: 12px; background: var(--color-white); font: inherit; color: var(--color-twig); }
+.submit-field textarea { resize: vertical; }
+.submit-field input:focus, .submit-field textarea:focus, .submit-field select:focus { outline: 2px solid var(--color-yolk); border-color: var(--color-twig); }
+.submit-hint { margin-top: 6px; color: var(--color-bark); font-size: 12px; }
+.submit-button { width: 100%; }
+.submit-message { min-height: 1.7em; margin-top: 12px; color: var(--color-yolk-deep); font-size: 14px; font-weight: 700; }
+.submit-preview { background: var(--color-egg); }
+.submit-preview-icon { display: grid; place-items: center; width: 64px; height: 64px; margin-bottom: 20px; background: var(--color-white); border: 2px solid var(--color-twig); border-radius: 20px; font-size: 34px; }
+.submit-preview h3 { margin-bottom: 12px; font-size: 25px; }
+.submit-preview p { margin-bottom: 20px; font-size: 14px; }
+.submit-preview ul { display: grid; gap: 10px; }
+.submit-preview li { position: relative; padding-left: 24px; font-size: 14px; }
+.submit-preview li::before { content: "✓"; position: absolute; left: 0; font-weight: 700; }
+.submit-list-wrap { margin-top: 64px; }
+.submit-list-heading { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
+.submit-list-heading h3 { font-size: 26px; }
+.submit-count { padding: 4px 12px; background: var(--color-yolk); border: 1px solid var(--color-twig); border-radius: 999px; font-size: 13px; font-weight: 700; }
+.mvp-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
+.mvp-card { display: flex; flex-direction: column; min-width: 0; padding: 22px; background: var(--color-white); border: 2px solid var(--color-twig); border-radius: 18px; }
+.mvp-card-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 12px; }
+.mvp-category { padding: 4px 10px; background: var(--color-shell); border-radius: 999px; color: var(--color-bark); font-size: 12px; }
+.mvp-date { color: var(--color-bark); font-size: 11px; }
+.mvp-card h4 { margin-bottom: 8px; font-size: 22px; overflow-wrap: anywhere; }
+.mvp-card p { flex: 1; margin-bottom: 18px; color: var(--color-bark); font-size: 14px; overflow-wrap: anywhere; }
+.mvp-card-link { align-self: flex-start; color: var(--color-yolk-deep); font-size: 14px; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
+.mvp-empty { grid-column: 1 / -1; padding: 28px; background: var(--color-white); border: 2px dashed var(--color-line); border-radius: 18px; color: var(--color-bark); text-align: center; }
+@media (max-width: 900px) { .submit-layout { grid-template-columns: 1fr; } .mvp-list { grid-template-columns: repeat(2, 1fr); } }
+@media (max-width: 768px) { .submit-form, .submit-preview { padding: 22px; } .mvp-list { grid-template-columns: 1fr; } .submit-list-wrap { margin-top: 44px; } }
+
+
+/* ===== 섹션 5. 마지막 안내 | 담당: 곽재영 ===== */
 .cta {
   background-color: var(--color-twig);
   color: var(--color-white);
@@ -1596,43 +1641,3 @@
   font-size: 14px;
   color: var(--color-bark);
